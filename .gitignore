# Dependencies
node_modules/

# Build output
.next/
out/
build/

# Environment, contains the dashboard password hash. Never commit.
.env
.env.local
.env.*.local

# Local content and artefacts
# The live catalogue, reviews, metrics and portfolio documents. They are seeded
# on first run and edited through the dashboard, so they never belong in version
# control, but the TypeScript that implements the store does.
data/store/*.json

# Uploaded media
public/uploads/*
!public/uploads/.gitkeep

# Test + tooling artefacts
coverage/
*.tsbuildinfo
next-env.d.ts

# Editors / OS
.DS_Store
.idea/
.vscode/
