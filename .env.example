# Copy to `.env.local` (development) or into your hosting environment
# (production) and fill in the values below.

# ---------------------------------------------------------------- public site
# The approved origin the public site is served from. Drives canonical URLs,
# sitemap.xml and Open Graph tags. If omitted, the site falls back to the known
# production deployment rather than a placeholder domain.
NEXT_PUBLIC_SITE_URL=https://desired-homes-interiors-amun.vercel.app

# ------------------------------------------------------------------ dashboard
# Host that serves the dashboard. Requests for /admin on any other host are
# not served, so the shop and the back office never share a URL.
#   local:      admin.localhost:3000
#   production: admin.your-domain.com
ADMIN_HOST=admin.localhost:3000

# Signing key for dashboard sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Password for the dashboard, as a scrypt hash. Generate with:
#   npm run admin:hash -- "a-long-password-you-choose"
# The plaintext password is never stored anywhere.
ADMIN_PASSWORD_HASH=
