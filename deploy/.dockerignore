# ---- Docker -------------------------------------------------------------- #
node_modules
.next
npm-debug.log*
Dockerfile
.dockerignore
docker-compose.yml

# ---- Version control ----------------------------------------------------- #
.git
.gitignore

# ---- Environment --------------------------------------------------------- #
.env
.env.local
